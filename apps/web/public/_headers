# Cloudflare Pages headers. Copied to out/_headers by the static export.
# Privacy-first (safety app): no-referrer so navigations never leak this site as
# the referrer; geolocation allowed only for the on-device "near me" feature.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: geolocation=(self), camera=(), microphone=()

# The generated share image is emitted without a file extension, so pin its type
# explicitly - with nosniff on, scrapers reject it unless the Content-Type is exact.
/opengraph-image
  Content-Type: image/png
  Cache-Control: public, max-age=86400
